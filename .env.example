# TraceHealer runs the complete reproduce → patch → verify → local commit flow
# without secrets. Runtime artifacts are stored in .tracehealer-data by default.
APP_URL=http://localhost:3000
TRACEHEALER_DATA_DIR=

# neatlogs-compatible intake and verified-run export.
# Export URL is intentionally configurable until your neatlogs project exposes
# its exact ingest endpoint/schema.
NEATLOGS_WEBHOOK_SECRET=
NEATLOGS_EXPORT_URL=
NEATLOGS_API_KEY=
NEXT_PUBLIC_NEATLOGS_DASHBOARD_URL=https://app.neatlogs.com

# GitHub draft-PR delivery. Point this at a separate target-agent repository,
# not the TraceHealer application repository. Automatic delivery creates a
# draft only; TraceHealer never merges.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
AUTO_PUBLISH_DRAFT=false

# Optional model provider for a future generic patch strategy. The deterministic
# verified strategy remains active when unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional repository graph provider adapter.
ENTIRE_API_URL=
ENTIRE_API_KEY=

# Optional verified-run notification.
SLACK_WEBHOOK_URL=

# Optional dashboard extras (display only, never secrets):
# JSON array of {provider,label,url} sponsor links; https URLs only, max 5.
TRACEHEALER_SPONSOR_LINKS=
# JSON object {costPerMinute,manualMinutes,incidentCount} used ONLY to render an
# explicitly labeled estimate. Negative, non-finite, or out-of-bounds values are
# dropped so no savings figure is shown.
TRACEHEALER_REPORTING_ASSUMPTIONS=

# ---- Authentication and tenancy ----
# `local` (default) is DEVELOPMENT ONLY: it grants a synthetic admin principal so
# the zero-secret demo keeps working, and it refuses to serve when
# NODE_ENV=production unless you explicitly set TRACEHEALER_LOCAL_AUTH_ACK=true.
# `session` is the production mode: every request must carry a valid HMAC-signed
# HTTP-only SameSite session cookie. It fails closed (503) without a secret.
TRACEHEALER_AUTH_MODE=local
TRACEHEALER_SESSION_SECRET=
# Only for single-tenant local/demo deployments. Never a substitute for
# TRACEHEALER_AUTH_MODE=session in a real multi-tenant deployment.
TRACEHEALER_LOCAL_AUTH_ACK=false
TRACEHEALER_TENANT_ID=local
TRACEHEALER_WORKSPACE_ID=local

# ---- Administrator policy (all optional; safe defaults shown) ----
# Only these repositories may be healed. Default is the demo target.
TRACEHEALER_ALLOWED_REPOSITORIES=northstar/support-agent
# Only these repository-relative paths may be rewritten by a patch.
TRACEHEALER_ALLOWED_PATHS=src/order-support.mjs
# Binaries the sandbox may execute.
TRACEHEALER_ALLOWED_BINARIES=node,git,npm
# Glob paths a patch may never touch (tests/CI/lockfiles are protected anyway).
# TRACEHEALER_PROTECTED_PATHS=.github/**,package.json,package-lock.json
# Allow patches that modify test files (disabled by default).
TRACEHEALER_ALLOW_TEST_EDITS=false
# Allow a model provider to propose patches (disabled by default).
TRACEHEALER_ALLOW_MODEL_PATCHES=false

# ---- Sandbox execution boundary ----
# `local-process` (default) runs the trusted target fixture in this process.
# `docker` selects the hardened container provider. The provider, its argument
# contract, and a live isolation proof exist, but it is NOT bound to the pipeline
# yet, so requesting it fails closed (503 unconfigured) instead of silently
# downgrading to the in-process sandbox. An unknown value is rejected outright.
TRACEHEALER_SANDBOX_PROVIDER=local-process
# Container provider settings (used once the provider is wired):
TRACEHEALER_CONTAINER_IMAGE=tracehealer-sandbox:latest
TRACEHEALER_CONTAINER_MEMORY_MB=512
TRACEHEALER_CONTAINER_CPUS=1
TRACEHEALER_CONTAINER_PIDS_LIMIT=128
TRACEHEALER_CONTAINER_UID=1000
TRACEHEALER_CONTAINER_GID=1000

# ---- Limits, timeouts, and webhook freshness ----
TRACEHEALER_COMMAND_TIMEOUT_MS=20000
TRACEHEALER_MAX_OUTPUT_BYTES=1048576
TRACEHEALER_MAX_DIFF_BYTES=200000
TRACEHEALER_MAX_REQUEST_BYTES=524288
TRACEHEALER_RATE_LIMIT=30
TRACEHEALER_RUN_TIMEOUT_MS=120000
TRACEHEALER_WEBHOOK_TOLERANCE_MS=300000
# Require every webhook to carry a fresh x-neatlogs-timestamp header.
TRACEHEALER_WEBHOOK_REQUIRE_TIMESTAMP=false
# Optional: pin the local repository graph to a checked-out repository.
# TRACEHEALER_TARGET_REPO_DIR=/abs/path/to/checked-out/repo
