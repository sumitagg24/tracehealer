# TraceHealer runs end-to-end in demo mode without secrets.
APP_URL=http://localhost:3000

# Optional neatlogs webhook verification and trace deep links.
NEATLOGS_WEBHOOK_SECRET=
NEXT_PUBLIC_NEATLOGS_DASHBOARD_URL=https://app.neatlogs.com

# Optional GitHub App / fine-grained token for creating real patch PRs.
# Use a token scoped only to the target demo repository.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main

# Optional model provider. The deterministic demo healer is used when unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
