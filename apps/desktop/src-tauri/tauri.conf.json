{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TraceHealer",
  "version": "0.1.0",
  "identifier": "com.neathack.tracehealer",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "TraceHealer",
        "width": 1280,
        "height": 840,
        "minWidth": 940,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; frame-src 'none'; object-src 'none'",
      "capabilities": ["default"]
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "TraceHealer"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app", "dmg", "appimage", "deb"],
    "icon": ["icons/icon.png"],
    "windows": {
      "wix": { "language": "en-US" }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {}
}
